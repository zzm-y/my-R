## 1. 加载包

```{r load-packages}
packages <- c("tidyverse", "bruceR", "effsize", "BayesFactor",
              "knitr", "kableExtra", "ggplot2", "patchwork", "readxl")

for (pkg in packages) {
  if (!require(pkg, character.only = TRUE)) {
    install.packages(pkg, dependencies = TRUE)
    library(pkg, character.only = TRUE)
  }
}
```

## 2. 读取全部数据

数据来源：Axt et al. (2018), Journal of Experimental Social Psychology.

```{r read-all-data}
# 基础路径
base_dir <- file.path(getwd(), "1R复现", "Axt_2018_Raw_Data", "extracted")

# ---- 2.1 主研究 Study1-5 ----
studies_main <- c("Study1", "Study2", "Study3", "Study4", "Study5")
df_list <- list()

for (s in studies_main) {
  fp <- file.path(base_dir, paste0(s, "Data"), paste0(s, "Data"), paste0(s, "Data.csv"))
  df_list[[s]] <- read.csv(fp, stringsAsFactors = FALSE)
  cat(sprintf("✓ %-10s: %4d 行, %3d 列\n", s, nrow(df_list[[s]]), ncol(df_list[[s]])))
}

# ---- 2.2 补充研究 StudyS1-S8 ----
studies_supp <- c("StudyS1", "StudyS2", "StudyS3", "StudyS4",
                  "StudyS5", "StudyS6", "StudyS7", "StudyS8")

for (s in studies_supp) {
  folder <- file.path(base_dir, paste0(s, "Data"), paste0(s, "Data"))

  if (s == "StudyS2") {
    # StudyS2 是 Excel 格式
    fp <- file.path(folder, "StudyS2Data.xlsx")
    df_list[[s]] <- read_excel(fp)
  } else {
    fp <- file.path(folder, paste0(s, "Data.csv"))
    df_list[[s]] <- read.csv(fp, stringsAsFactors = FALSE)
  }
  cat(sprintf("✓ %-10s: %4d 行, %3d 列\n", s, nrow(df_list[[s]]), ncol(df_list[[s]])))
}

# ---- 2.3 设置默认数据框为 Study1 ----
df_raw <- df_list[["Study1"]]
```

