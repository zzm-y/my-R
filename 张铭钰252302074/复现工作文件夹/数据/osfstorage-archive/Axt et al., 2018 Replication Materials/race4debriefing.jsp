yg = 644.083, 10.581<br>gm = 727.166, 22.045<br>mg = 627.083, 11.581<br>";   // fulltext +="hm = 750.583, 97.882<br>mh = 650.166, 25.758<br>hy = 827.166, 22.045<br>yh = 644.083, 10.581<br>my = 727.166, 22.045<br>ym = 644.083, 11.581<br>";String[] iats = {		 "race4_abhwawhbahwb",		 "race4_abwhahwbawhb",		 "race4_ahbwawbhabwh",		 "race4_ahwbabwhawbh",		 "race4_awbhahbwabhw",		 "race4_awhbabhwahbw",		 "race4_bahwbwhabhwa",		 "race4_bawhbhwabwha",		 "race4_bhawbwahbawh",		 "race4_bhwabawhbwah",		 "race4_bwahbhawbahw",		 "race4_bwhabahwbhaw",		 "race4_habwhwbahbwa",		 "race4_hawbhbwahwba",		 "race4_hbawhwabhawb",		 "race4_hbwahawbhwab",		 "race4_hwabhbawhabw",		 "race4_hwbahabwhbaw",		 "race4_wabhwhbawbha",		 "race4_wahbwbhawhba",		 "race4_wbahwhabwahb",		 "race4_wbhawahbwhab",		 "race4_whabwbahwabh",		 "race4_whbawabhwbah"		 };                    String fulltext=null;   int gooddata=0;   String[] ptables = new String[11];    for (int i=0;i<11;i++) ptables[i]="";         StudySession mysession = (StudySession) session.getAttribute("studysession");      int match=-1;      String mygroups="";   if (mysession!=null) {      for (int i=0; i<iats.length; i++) {      fulltext = mysession.v(iats[i]+".text");     if (fulltext!=null) {match=i;break;}    }      if (fulltext!=null) {             String[] fulltextarray = fulltext.split("<br>");            char[] pchars = {'a','b','h','w'};         String[] pnames= {"Asian people", "Black people","Hispanic people", "White people"};   String[] pfnames= {"asians", "blacks", "hispanics", "whites"};     mygroups="Asian people, Black people, Hispanic people, and White people";                    double[][] pmeans = new double[4][4];   double[][] psds =   new double[4][4];   double[]   pmeandiff = new double[4];   double[]   pgrandmean = new double[4];   double[]   pvariance = new double[4];   double[]   pscore = new double[4];             if (fulltextarray.length>=12) {    gooddata=1;    for (int i=0;i<fulltextarray.length;i++) {        String[] namevaluepair=fulltextarray[i].split("=");    namevaluepair[0]=namevaluepair[0].trim();          if (namevaluepair.length==2) {       int p=-1; int q=-1;         //System.out.println(namevaluepair[0]);     for (int j=0; j<4;j++)       if (namevaluepair[0].charAt(0)==pchars[j]) {p=j;break;}           for (int j=0; j<4;j++)       if (namevaluepair[0].charAt(1)==pchars[j]) {q=j;break;}          //  System.out.println(p+ " "+q);      String[] meansd = namevaluepair[1].split(",");           pmeans[p][q] = Double.parseDouble(meansd[0]);      psds[p][q] = Double.parseDouble(meansd[1]);            }      }            for (int i=0; i<4; i++) {            pgrandmean[i]=0;      for (int j=0;j<4;j++)        if (i!=j) { pgrandmean[i]+=pmeans[i][j]/6;pgrandmean[i]+=pmeans[j][i]/6;}      pmeandiff[i]=0;      for (int j=0;j<4;j++)        if (i!=j) { pmeandiff[i]-=pmeans[i][j]/3;pmeandiff[i]+=pmeans[j][i]/3;}      pvariance[i]=0;           for (int j=0;j<4;j++)        if (i!=j) { pvariance[i]+=psds[i][j]*psds[i][j];pvariance[i]+=psds[j][i]*psds[j][i];}           for (int j=0;j<4;j++)        if (i!=j) { pvariance[i]+=(pmeans[i][j]-pgrandmean[i])*(pmeans[i][j]-pgrandmean[i]);pvariance[i]+=(pmeans[j][i]-pgrandmean[i])*(pmeans[j][i]-pgrandmean[i]);}            pvariance[i]=16*pvariance[i];      pscore[i]=pmeandiff[i]/Math.sqrt(pvariance[i]/96);           //System.out.println(pmeandiff[i]+" "+pvariance[i]+ " " + pscore[i]);   }               double[] plimits = {2,1,0.65,0.5,0.35,0.15,-0.15,-0.35,-0.5,-0.65,-1,-2};    for (int i=1;i<12;i++)      for (int j=0;j<4;j++)           if ((pscore[j]<plimits[i-1]) && (pscore[j]>=plimits[i]))             ptables[i-1] += "&nbsp;&nbsp;<img style=\"vertical-align:middle\" src=\"/implicit/user/jaxt/fourcat/images/" + pfnames[j] + "tiny.jpg\">&nbsp;<b>" +pnames[j]+ "</b>&nbsp;" ;                                 }