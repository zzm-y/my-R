)
knitr::kable(result, digits = 3)
library(effectsize)
d_result <- cohens_d(D_score ~ condition, data = df_black)
d_result
good_data <- df_black %>%
filter(condition == "good") %>%
pull(D_score)
t_one <- t.test(good_data, mu = 0, alternative = "less")
d_one <- mean(good_data, na.rm = TRUE) / sd(good_data, na.rm = TRUE)
n_good <- sum(!is.na(good_data))
se_d_one <- sqrt(1 / n_good + d_one^2 / (2 * n_good))
cat("\n════════════════════════════════════\n")
cat("  Good 组单样本 t 检验（H₁: μ < 0）\n")
cat("────────────────────────────────────\n")
cat(sprintf("  n        = %d\n", n_good))
cat(sprintf("  Mean     = %.3f\n", mean(good_data, na.rm = TRUE)))
cat(sprintf("  SD       = %.3f\n", sd(good_data, na.rm = TRUE)))
cat(sprintf("  t(%s)  = %.3f\n", round(t_one$parameter, 2), t_one$statistic))
cat(sprintf("  p        = %.4f\n", t_one$p.value))
cat("────────────────────────────────────\n")
cat(sprintf("  Cohen's d = %.3f\n", d_one))
cat(sprintf("  95%% CI    [%.3f, %.3f]\n", d_one - 1.96 * se_d_one, d_one + 1.96 * se_d_one))
cat("════════════════════════════════════\n")
bad_data <- df_black %>%
filter(condition == "bad") %>%
pull(D_score)
# 双向
t_bad_two <- t.test(bad_data, mu = 0, alternative = "two.sided")
# 单侧（大于 0）
t_bad_greater <- t.test(bad_data, mu = 0, alternative = "greater")
# d 值
d_bad <- mean(bad_data, na.rm = TRUE) / sd(bad_data, na.rm = TRUE)
n_bad <- sum(!is.na(bad_data))
se_d_bad <- sqrt(1 / n_bad + d_bad^2 / (2 * n_bad))
cat("\n═══════════════════════════════════════════════\n")
cat("  Bad 组单样本 t 检验\n")
cat("───────────────────────────────────────────────\n")
cat(sprintf("  n        = %d\n", n_bad))
cat(sprintf("  Mean     = %.3f\n", mean(bad_data, na.rm = TRUE)))
cat(sprintf("  SD       = %.3f\n", sd(bad_data, na.rm = TRUE)))
cat("───────────────────────────────────────────────\n")
cat(sprintf("  双向（H₁: μ ≠ 0）\n"))
cat(sprintf("    t(%s) = %.3f, p = %.4f\n",
round(t_bad_two$parameter, 2), t_bad_two$statistic, t_bad_two$p.value))
cat("───────────────────────────────────────────────\n")
cat(sprintf("  单侧（H₁: μ > 0）\n"))
cat(sprintf("    t(%s) = %.3f, p = %.4f\n",
round(t_bad_greater$parameter, 2), t_bad_greater$statistic, t_bad_greater$p.value))
cat("───────────────────────────────────────────────\n")
cat(sprintf("  Cohen's d = %.3f\n", d_bad))
cat(sprintf("  95%% CI    [%.3f, %.3f]\n",
d_bad - 1.96 * se_d_bad, d_bad + 1.96 * se_d_bad))
cat("═══════════════════════════════════════════════\n")
desc <- df_black %>%
group_by(condition) %>%
summarise(
n    = sum(!is.na(D_score)),
mean = mean(D_score, na.rm = TRUE),
sd   = sd(D_score, na.rm = TRUE)
)
t_res <- t.test(D_score ~ condition, data = df_black)
d_res <- cohens_d(D_score ~ condition, data = df_black)
cat("══════════════════════════════════════════\n")
cat("         good-focal          bad-focal\n")
cat("──────────────────────────────────────────\n")
cat(sprintf("  n      %6d              %6d\n", desc$n[1], desc$n[2]))
cat(sprintf("  Mean   %8.3f            %8.3f\n", desc$mean[1], desc$mean[2]))
cat(sprintf("  SD     %8.3f            %8.3f\n", desc$sd[1], desc$sd[2]))
cat("──────────────────────────────────────────\n")
cat(sprintf("Welch t(%s) = %.3f, p = %.4f\n",
round(t_res$parameter, 2), t_res$statistic, t_res$p.value))
cat("──────────────────────────────────────────\n")
cat(sprintf("Cohen's d = %.3f, 95%% CI [%.3f, %.3f]\n",
d_res$Cohens_d, d_res$CI_low, d_res$CI_high))
cat("══════════════════════════════════════════\n")
# 各组的 Pearson 相关
cor_good <- df_clean %>%
filter(condition == "good") %>%
summarise(
r = cor(WhiteBlackExp, WhiteBlackBIAT, use = "complete.obs"),
n = sum(!is.na(WhiteBlackExp) & !is.na(WhiteBlackBIAT))
)
# 各组的 Pearson 相关（df_clean 中条件列名为 Condition）
cor_good <- df_clean %>%
filter(Condition == "good") %>%
summarise(
r = cor(WhiteBlackExp, WhiteBlackBIAT, use = "complete.obs"),
n = sum(!is.na(WhiteBlackExp) & !is.na(WhiteBlackBIAT))
)
cor_bad <- df_clean %>%
filter(Condition == "bad") %>%
summarise(
r = cor(WhiteBlackExp, WhiteBlackBIAT, use = "complete.obs"),
n = sum(!is.na(WhiteBlackExp) & !is.na(WhiteBlackBIAT))
)
cor_bad <- df_clean %>%
filter(condition == "bad") %>%
summarise(
r = cor(WhiteBlackExp, WhiteBlackBIAT, use = "complete.obs"),
n = sum(!is.na(WhiteBlackExp) & !is.na(WhiteBlackBIAT))
)
