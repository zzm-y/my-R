library(tidyverse)
base_dir <- "C:/Users/zhangshengli/Desktop/Rall/R语言/R4Psy-main/1R复现/Axt_2018_Raw_Data/extracted"
df_s1 <- read_csv(
file.path(base_dir, "Study1Data", "Study1Data", "Study1Data.csv"),
na = c("", " ", ".", "NA")
)
glimpse(df_s1)
# 美国公民/居民
table(df_s1$usresorcit, useNA = "ifany")
# TooFast 分布
summary(df_s1$TooFast)
# 种族分布
table(df_s1$Race)
df_clean <- df_s1 %>%
filter(
usresorcit == 1,
TooFast < 0.1,
Race == "White"
)
cat("筛选后样本量:", nrow(df_clean), "\n")
df_black <- df_clean %>%
select(
condition = Condition,
D_score   = WhiteBlackBIAT
)
head(df_black)
result <- df_black %>%
group_by(condition) %>%
summarise(
n    = sum(!is.na(D_score)),
mean = mean(D_score, na.rm = TRUE),
sd   = sd(D_score, na.rm = TRUE)
)
knitr::kable(result, digits = 3)
original <- tibble(
condition = c("good", "bad"),
orig_n    = c(856, 751),
orig_mean = c(-0.12, 0.16),
orig_sd   = c(0.60, 0.64)
)
comparison <- result %>%
left_join(original, by = "condition") %>%
mutate(
PE_n    = abs(n - orig_n) / orig_n * 100,
PE_mean = abs(mean - orig_mean) / orig_mean * 100,
PE_sd   = abs(sd - orig_sd) / orig_sd * 100
)
knitr::kable(comparison, digits = 2)
t.test(D_score ~ condition, data = df_black, var.equal = TRUE)
