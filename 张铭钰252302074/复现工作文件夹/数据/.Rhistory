library(tidyverse)
base_dir <- "C:/Users/zhangshengli/Desktop/Rall/R语言/R4Psy-main/1R复现/Axt_2018_Raw_Data/extracted"
df_s1 <- read_csv(
file.path(base_dir, "Study1Data", "Study1Data", "Study1Data.csv"),
na = c("", " ", ".", "NA")
)
glimpse(df_s1)
table(df_s1$usresorcit, useNA = "ifany")
summary(df_s1$TooFast)
table(df_s1$Race)
df_clean <- df_s1 %>%
filter(
usresorcit == 1,
TooFast < 0.1,
Race == "Black"
)
cat("筛选后样本量:", nrow(df_clean), "\n")
df_black <- df_clean %>%
select(
condition = Condition,
D_score   = WhiteBlackBIAT
)
head(df_black)
result <- df_black %>%
group_by(condition) %>%
