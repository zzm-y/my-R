head(df_black)
# 检查是否有缺失
sum(is.na(df_black$D_score))
df_black %>%
group_by(condition) %>%
summarise(
n    = sum(!is.na(D_score)),
mean = mean(D_score, na.rm = TRUE),
sd   = sd(D_score, na.rm = TRUE)
)
